<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="SETTINGS &amp; LOCATION"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Edit Explorer Profile"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Avatar selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/img_edit_profile_avatar"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:background="@drawable/bg_secondary_button"
                android:contentDescription="Profile Photo"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_ceylonsteps_brand_logo"

            <Button
                android:id="@+id/btn_edit_pick_photo"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_secondary_button"
                android:paddingHorizontal="16dp"
                android:text="Change Avatar"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Edit Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Explorer Name"
            android:textColor="#C9D1D9"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_edit_name"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field"
            android:hint="Your Name"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#6E7681"
            android:textSize="14sp" />

        <!-- Edit Home Base -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Home Base Location"
            android:textColor="#C9D1D9"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_edit_gps_location"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_secondary_button"
            android:text="📍 Update with GPS Location"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_edit_manual_location"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input_field"
            android:hint="Paste new Google Maps URL or Coordinates"
            android:inputType="textUri"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#6E7681"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_secondary_button"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_edit_home_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Colombo, Western Province"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_edit_home_coords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="6.92710° N, 79.86120° E"
                android:textColor="#00E5FF"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_edit_save"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_primary_button"
            android:text="Save Changes"
            android:textColor="#0D1117"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
