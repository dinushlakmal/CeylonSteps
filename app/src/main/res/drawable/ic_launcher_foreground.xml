<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="15"
        android:translateY="15"
        android:scaleX="0.75"
        android:scaleY="0.75">

        <!-- Sri Lanka Map Silhouette (White) -->
        <!-- Teardrop shape adjusted to approximate SL -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 45 15 C 50 12 55 18 60 30 C 65 45 78 60 75 78 C 72 92 55 98 45 95 C 30 90 20 75 25 55 C 28 40 38 20 45 15 Z" />
        
        <!-- Northern bits (Jaffna/Mannar approximation) -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 38 8 C 42 5 47 8 44 12 C 41 15 35 12 38 8 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 28 32 C 32 28 36 33 33 36 C 30 39 25 36 28 32 Z" />

        <!-- Location Pin (Orange/Yellow) placed at top-right (Trincomalee/East area) -->
        <group
            android:translateX="55"
            android:translateY="8"
            android:scaleX="0.7"
            android:scaleY="0.7"
            android:rotation="10">
            <!-- Pin Shadow -->
            <path
                android:fillColor="#22000000"
                android:pathData="M 15 35 L 5 -10 L 25 -10 Z" />
            <!-- Pin Base -->
            <path
                android:fillColor="#F5A623"
                android:pathData="M 15 -10 C 2 -10 -8 0 -8 13 C -8 28 15 48 15 48 C 15 48 38 28 38 13 C 38 0 28 -10 15 -10 Z" />
            <!-- Pin Inner Hole -->
            <path
                android:fillColor="#0F2B48"
                android:pathData="M 15 5 C 20 5 24 9 24 14 C 24 19 20 23 15 23 C 10 23 6 19 6 14 C 6 9 10 5 15 5 Z" />
        </group>

        <!-- Cyan Arrow Cursor pointing towards the map -->
        <group
            android:translateX="10"
            android:translateY="45"
            android:scaleX="0.8"
            android:scaleY="0.8"
            android:rotation="55">
            <!-- Shadow for depth -->
            <path
                android:fillColor="#44000000"
                android:pathData="M -3 5 L -3 45 L 9 33 L 22 50 L 27 45 L 14 28 L 29 25 Z" />
            <!-- Arrow Body -->
            <path
                android:fillColor="#00E5FF"
                android:pathData="M 0 0 L 0 40 L 12 28 L 25 45 L 30 40 L 17 23 L 32 20 Z" />
        </group>
    </group>
</vector>
